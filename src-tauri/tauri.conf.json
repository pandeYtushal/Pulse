{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "mainBinaryName": "Pulse",
  "version": "1.0.2",
  "identifier": "com.pulse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pulse",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "A quiet system layer for Windows.",
    "longDescription": "Pulse brings Windows media, notifications, clipboard, power, device, screenshot, and privacy activity into one compact surface.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
